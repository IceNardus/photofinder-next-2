{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoFinder Next",
  "version": "0.1.0",
  "identifier": "com.photofinder.next",
  "build": {
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PhotoFinder Next",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "../../../models/"
    ],
    "category": "Photo",
    "shortDescription": "Local AI photo engine — person + object search",
    "longDescription": "Cross-platform offline photo search with face and object recognition."
  },
  "plugins": {}
}
